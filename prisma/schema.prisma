generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model Profile {
  id               String    @id @db.Uuid
  email            String    @unique
  fullName         String?   @map("full_name")
  avatarUrl        String?   @map("avatar_url")
  bio              String?   @db.Text
  passwordHash     String?   @map("password_hash")
  lastSignIn       DateTime? @map("last_sign_in") @db.Timestamptz(6)
  createdAt        DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  departmentLayout String    @default("fullWidth") @map("department_layout")
  theme            String    @default("standard")
  users            users     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projectMemberships ProjectMember[]

  @@map("profiles")
  @@schema("public")
}

model Project {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  title       String
  description String?
  departments String[] @default([])
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  users       users    @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projectDepartments ProjectDepartment[]
  members     ProjectMember[]
  invites     ProjectInvite[]
  tasks       ProjectTask[]

  @@map("projects")
  @@schema("public")
}

model ProjectDepartment {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  color       String   @default("#DDE7FF")
  textColor   String   @map("text_color") @default("#2F2766")
  head        String?  @db.VarChar(255)
  memberCount Int      @map("member_count") @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members     ProjectMember[]
  invites     ProjectInvite[]
  tasks       ProjectTask[]

  @@map("project_departments")
  @@schema("public")
}

enum ProjectRole {
  OWNER
  HEADER
  MEMBER

  @@schema("public")
}

enum ProjectMemberStatus {
  ACTIVE
  INVITED

  @@schema("public")
}

model ProjectMember {
  id            String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId     String               @map("project_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  role          ProjectRole          @default(MEMBER)
  username      String
  departmentId  String?              @map("department_id") @db.Uuid
  status        ProjectMemberStatus  @default(ACTIVE)
  lastSeenAt    DateTime?            @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile       Profile              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department    ProjectDepartment?   @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdTasks  ProjectTask[]        @relation("TaskCreatedBy")
  taskAssignments ProjectTaskAssignee[]
  submissionsCreated ProjectTaskSubmission[] @relation("SubmissionSubmittedBy")
  submissionsReviewed ProjectTaskSubmission[] @relation("SubmissionReviewer")

  @@unique([projectId, userId])
  @@map("project_members")
  @@schema("public")
}

model ProjectInvite {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  departmentId  String?             @map("department_id") @db.Uuid
  token         String              @unique
  role          ProjectRole         @default(MEMBER)
  createdBy     String              @map("created_by") @db.Uuid
  maxUses       Int?                @map("max_uses")
  useCount      Int                 @default(0) @map("use_count")
  expiresAt     DateTime?           @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?           @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department    ProjectDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("project_invites")
  @@schema("public")
}

enum ProjectTaskStatus {
  SUBMITTED
  IN_PROGRESS
  BLOCKED

  @@schema("public")
}

model ProjectTask {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  departmentId     String?           @map("department_id") @db.Uuid
  createdByMemberId String           @map("created_by_member_id") @db.Uuid
  title            String
  detail           String?           @db.Text
  status           ProjectTaskStatus @default(SUBMITTED)
  startDate        DateTime?         @map("start_date") @db.Timestamptz(6)
  dueDate          DateTime?         @map("due_date") @db.Timestamptz(6)
  cardColor        String            @map("card_color") @default("#F6F0FF")
  cardTextColor    String            @map("card_text_color") @default("#2F2766")
  createdAt        DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department       ProjectDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdBy        ProjectMember     @relation("TaskCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignees        ProjectTaskAssignee[]
  submissions      ProjectTaskSubmission[]

  @@index([projectId], map: "project_tasks_project_id_idx")
  @@index([departmentId], map: "project_tasks_department_id_idx")
  @@map("project_tasks")
  @@schema("public")
}

model ProjectTaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  assignedAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("assigned_at") @db.Timestamptz(6)
  task       ProjectTask   @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  member     ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([taskId, memberId])
  @@index([memberId], map: "project_task_assignees_member_id_idx")
  @@map("project_task_assignees")
  @@schema("public")
}

enum SubmissionStatus {
  SUBMITTED
  REVISION_REQUESTED
  APPROVED

  @@schema("public")
}

model ProjectTaskSubmission {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taskId             String            @map("task_id") @db.Uuid
  submittedById      String            @map("submitted_by_id") @db.Uuid
  reviewerId         String?           @map("reviewer_id") @db.Uuid
  status             SubmissionStatus  @default(SUBMITTED)
  description        String?           @db.Text
  reviewerComment    String?           @map("reviewer_comment") @db.Text
  attachmentMetadata Json?             @map("attachment_metadata")
  acknowledgedAt     DateTime?         @map("acknowledged_at") @db.Timestamptz(6)
  ownerAcknowledgedAt DateTime?        @map("owner_acknowledged_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)
  task               ProjectTask       @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submittedBy        ProjectMember     @relation("SubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer           ProjectMember?    @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([taskId], map: "project_task_submissions_task_id_idx")
  @@map("project_task_submissions")
  @@schema("public")
}

